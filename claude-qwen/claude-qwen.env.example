# as-claude-qwen: Claude Code on a LiteLLM model (CLAUDE_QWEN_MODEL in .env) through as-llm-gw.
# Its LiteLLM virtual key (alias "claude-qwen", not LITELLM_MASTER_KEY): generated by
# gen-secrets.sh, registered in LiteLLM by as-litellm-keys. Claude Code sends it as the bearer token.
ANTHROPIC_AUTH_TOKEN=CHANGE_ME_LITELLM_KEY_CLAUDE_QWEN
# Message bus (as-zenoh, user claude-qwen): the same value as in zenoh/zenoh.env
ZENOH_PASSWORD_CLAUDE_QWEN=CHANGE_ME_ZENOH_PASSWORD_CLAUDE_QWEN
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
ENABLE_CLAUDEAI_MCP_SERVERS=false
NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/proxy-ca.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
