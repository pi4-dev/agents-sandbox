# as-opencode: opencode on a LiteLLM model (opencode/opencode.jsonc) through as-llm-gw.
# Its LiteLLM virtual key (alias "opencode", not LITELLM_MASTER_KEY): generated by
# gen-secrets.sh, registered in LiteLLM by as-litellm-keys; opencode.jsonc reads it.
OPENCODE_LITELLM_KEY=CHANGE_ME_LITELLM_KEY_OPENCODE
# Message bus (as-zenoh, user opencode): the same value as in zenoh/zenoh.env
ZENOH_PASSWORD_OPENCODE=CHANGE_ME_ZENOH_PASSWORD_OPENCODE
# opencode's own cloud models (opencode/*-free) not even listed; policies in opencode.jsonc
# allow only litellm anyway. No self-update (also "update": "disable" in opencode.jsonc).
OPENCODE_DISABLE_FREE_MODELS=1
OPENCODE_DISABLE_AUTOUPDATE=1
# Squid bumps all TLS: the proxy CA (baked into the image, also in the system store)
NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/proxy-ca.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
