# as-zenoh: one login per system on the message bus. ZENOH_PASSWORD_<NAME> makes user
# <name> (lower case); zenoh/conf/zenoh.json5 gives each user its ACL. The same value goes
# into the system's own env file (gen-secrets.sh copies it, check-env.sh compares them).
ZENOH_PASSWORD_HERMES=CHANGE_ME_ZENOH_PASSWORD_HERMES
ZENOH_PASSWORD_CLAUDE=CHANGE_ME_ZENOH_PASSWORD_CLAUDE
