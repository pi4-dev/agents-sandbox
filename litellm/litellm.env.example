# ./gen-secrets.sh fills every generated CHANGE_ME_* (CLAUDE_OAI_KEY included); the provider
# keys (OPENROUTER_API_KEY, ...) are yours to set. ./check-env.sh (run by start-main.sh) refuses to start with a
# placeholder left.

# LiteLLM admin key (sk- prefix), e.g. sk-$(openssl rand -hex 24); never give it to clients
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY
# key the Claude bridge requires; generated, the same value goes to claude-bridge/claude-bridge.env
CLAUDE_OAI_KEY=CHANGE_ME_CLAUDE_OAI_KEY

# SSL_CERT_FILE/REQUESTS_CA_BUNDLE REPLACE the system CAs. Every HTTPS request
# of LiteLLM goes through the proxy (bump, signed by the proxy CA), LAN endpoints in
# squid/conf/lan.hosts included. Only direct HTTPS inside as-net-blind (NO_PROXY) would
# need a bundle with both the system CAs and the proxy CA.
SSL_CERT_FILE=/certs/proxy-ca.crt
REQUESTS_CA_BUNDLE=/certs/proxy-ca.crt

# --- provider keys, one block per file in litellm/models/ (see litellm/models/README.md) ---
# OpenRouter (litellm/models/openrouter.yaml): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_API_KEY

# user, password and database = POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB from litellm-db.env
DATABASE_URL=postgresql://litellm:CHANGE_ME_POSTGRES_PASSWORD@as-litellm-db:5432/litellm
# openssl rand -hex 32; never change it after the first start: it encrypts keys stored in the database
LITELLM_SALT_KEY=CHANGE_ME_LITELLM_SALT_KEY
NODE_EXTRA_CA_CERTS=/certs/proxy-ca.crt
