# Hermes managed scope: Compose mounts your copy (hermes/managed.env, created by
# gen-secrets.sh) read-only at /etc/hermes/.env in as-hermes.
#
# Why: Hermes loads /opt/data/.env (hermes/data/.env, which the agent can edit) over
# the container environment, so hermes/hermes.env cannot pin anything. This file is
# loaded last, over both, every time Hermes (re)loads its env.
#
# Configuration, not a security boundary: a HERMES_MANAGED_DIR line in /opt/data/.env
# points Hermes at another directory, and the terminal tool ignores these settings
# (README, "Security model"). The boundary is the set of mounts.
#
# No secrets: Hermes (PUID) must read this file, so the agent can read it too.
# After an edit: docker compose up -d --force-recreate as-hermes

# write_file/patch only below these roots (the image sets /opt/data alone);
# the same directories as the read-write mounts of as-hermes
HERMES_WRITE_SAFE_ROOT=/opt/data:/workspace
# web tools fetch no localhost or private addresses (the dashboard on :9119,
# *.as.internal, the LAN); an explicit false also wins over security.allow_private_urls
HERMES_ALLOW_PRIVATE_URLS=false
# no plugins auto-loaded from a project's ./.hermes/plugins/ (e.g. a repo in /workspace)
HERMES_ENABLE_PROJECT_PLUGINS=false
# empty: config.yaml decides. Stops a line in /opt/data/.env from adding a prompt
# or messages to every session.
HERMES_EPHEMERAL_SYSTEM_PROMPT=
HERMES_PREFILL_MESSAGES_FILE=
