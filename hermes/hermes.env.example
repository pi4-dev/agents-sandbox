TZ=Europe/Warsaw
# Host user owning ./data and ./workspace, e.g. id -u; id -g.
# Hermes retains its upstream entrypoint, which switches to this service identity.
PUID=1000
PGID=1000
HERMES_YOLO_MODE=true
HERMES_DASHBOARD=1
# Reachable only from HERMES_DASHBOARD_ALLOW_FROM (.env). Basic auth travels over
# plain HTTP, so keep that range limited to a trusted management network.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=CHANGE_ME_HERMES_DASHBOARD_USER
# openssl rand -hex 24
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME_HERMES_DASHBOARD_PASSWORD
# openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_HERMES_DASHBOARD_SECRET
# LiteLLM virtual key for Hermes (not LITELLM_MASTER_KEY). Generated by gen-secrets.sh,
# registered in LiteLLM by as-litellm-keys (alias "hermes").
LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY_HERMES
