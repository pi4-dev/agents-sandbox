TZ=Europe/Warsaw
# Host user owning ./data and ./workspace, e.g. id -u; id -g.
# Hermes retains its upstream entrypoint, which switches to this service identity.
PUID=1000
PGID=1000
HERMES_YOLO_MODE=true
HERMES_DASHBOARD=1
# Reachable only from HERMES_DASHBOARD_ALLOW_FROM (.env). Basic auth travels over
# plain HTTP, so keep that range limited to a trusted management network.
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=CHANGE_ME_HERMES_DASHBOARD_USER
# Every process with Hermes' UID, the agent included, reads the container env
# (/proc/PID/environ), so it holds no login secret:
# - a scrypt hash, not the plaintext HERMES_DASHBOARD_BASIC_AUTH_PASSWORD (which would
#   win over the hash). gen-secrets.sh writes the password to hermes/dashboard-password
#   (host only, not mounted) and the hash here, single-quoted: Compose expands $ otherwise.
# - no HERMES_DASHBOARD_BASIC_AUTH_SECRET: the dashboard signs sessions with a random key
#   per start instead (log in again after a restart).
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=CHANGE_ME_HERMES_DASHBOARD_PASSWORD_HASH
# LiteLLM virtual key for Hermes (not LITELLM_MASTER_KEY). Generated by gen-secrets.sh,
# registered in LiteLLM by as-litellm-keys (alias "hermes").
LITELLM_API_KEY=CHANGE_ME_LITELLM_KEY_HERMES
# Message bus (as-zenoh, user hermes): the same value as in zenoh/zenoh.env. Generated by
# gen-secrets.sh. ZENOH_CONNECT and ZENOH_USER come from docker-compose.yaml.
ZENOH_PASSWORD_HERMES=CHANGE_ME_ZENOH_PASSWORD_HERMES
