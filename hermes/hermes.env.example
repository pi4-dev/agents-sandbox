TZ: Europe/Warsaw
# Host user owning ./data and ./workspace, e.g. id -u; id -g.
# Hermes retains its upstream entrypoint, which switches to this service identity.
PUID: 1000
PGID: 1000
HERMES_YOLO_MODE: "true"
HERMES_DASHBOARD: "1"
HERMES_DASHBOARD_HOST: "0.0.0.0"
HERMES_DASHBOARD_PORT: "9119"
HERMES_DASHBOARD_BASIC_AUTH_USERNAME: <username>
# Generate with: openssl rand -hex 24, openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: <auth_password>
HERMES_DASHBOARD_BASIC_AUTH_SECRET: <auth_secret>
# Existing LiteLLM virtual key; do not use the master key.
LITELLM_API_KEY: <litellm-api-key>


HERMES_IMAGE=nousresearch/hermes-agent:stable
HERMES_BIND_IP=127.0.0.1
HERMES_DASHBOARD_PORT=9119

