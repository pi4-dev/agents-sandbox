#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1

# false = no MCP connectors from claude.ai
ENABLE_CLAUDEAI_MCP_SERVERS=false
NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/proxy-ca.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Message bus (as-zenoh, user claude): the same value as in zenoh/zenoh.env. Generated by
# gen-secrets.sh. ZENOH_CONNECT and ZENOH_USER come from docker-compose.yaml.
ZENOH_PASSWORD_CLAUDE=CHANGE_ME_ZENOH_PASSWORD_CLAUDE
