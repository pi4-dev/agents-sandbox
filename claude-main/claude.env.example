#CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1"
DISABLE_AUTOUPDATER: "1"
DISABLE_TELEMETRY: "1"
DISABLE_ERROR_REPORTING: "1"

ENABLE_CLAUDEAI_MCP_SERVERS: "false"   # jesli nie chcesz konektorów z claude.ai
NODE_EXTRA_CA_CERTS: /usr/local/share/ca-certificates/proxy-ca.crt
SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
CLAUDE_OAI_SYSTEM_PROMPT_FILE: /workspace/claude-oai/system-prompt.txt

