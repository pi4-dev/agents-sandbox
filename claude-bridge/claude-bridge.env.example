# Environment of as-claude-bridge only. The agent (as-claude-main) has its own,
# claude-main/claude.env; the two share no env file, directory, image or policy.

# Key between LiteLLM and the bridge. ./gen-secrets.sh fills it with the same value
# as in litellm/litellm.env: LiteLLM sends it as "Authorization: Bearer ...".
CLAUDE_OAI_KEY=CHANGE_ME_CLAUDE_OAI_KEY

# PORT (9090) and CLAUDE_OAI_HOST (0.0.0.0) are fixed in docker-compose.yaml
CLAUDE_OAI_CWD=/workspace
# force a model, e.g. claude-opus-5-5 (default: Claude Code's default model)
#CLAUDE_MODEL=

# Tools. Empty = chat only: no built-in tool exists in the session.
# Executor mode (the bridge acts, docs/CLAUDE_BRIDGE.md) is a second autonomous agent
# that every LiteLLM client (Hermes, Open WebUI users) can drive:
#CLAUDE_OAI_ALLOWED_TOOLS=Bash,Read,Edit,Write,Grep,Glob
#CLAUDE_OAI_PERMISSION_MODE=bypassPermissions
CLAUDE_OAI_ALLOWED_TOOLS=
CLAUDE_OAI_PERMISSION_MODE=default
#CLAUDE_OAI_DISALLOWED_TOOLS=

# fixed system prompt for every request (a file in the bridge workspace), and the
# auto-memory directory whose MEMORY.md index goes into the prompt
#CLAUDE_OAI_SYSTEM_PROMPT_FILE=/workspace/system-prompt.txt
#CLAUDE_OAI_MEMORY_DIR=/home/node/.claude/projects/-workspace/memory

DISABLE_AUTOUPDATER=1
DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
# false = no MCP connectors from claude.ai
ENABLE_CLAUDEAI_MCP_SERVERS=false
NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/proxy-ca.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
