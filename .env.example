# The only place with addressing. Services and agents use *.as.internal names:
# Docker network aliases (docker-compose.yaml), served to agents by as-dns.

# --- what runs besides the core (Squid, DNS, ingress, LiteLLM, as-llm-gw); README, "Profiles" ---
# claude (Claude agent), qwen (Claude on Qwen), hermes, bridge (Claude subscription as a
# LiteLLM model), headroom (compression), webui (Open WebUI), opencode, debug (as-netshoot);
# * = all.
# Comma-separated. Set them here, not with --profile: LiteLLM, its keys job and as-llm-gw
# read this value. After a change: docker compose up -d (stop what you dropped:
# docker compose stop <service>).
COMPOSE_PROFILES=claude,qwen,hermes,bridge,headroom,webui,opencode

# --- VLAN (macvlan): only the outer legs of as-squid and as-ingress ---
VLAN_PARENT=vlan100
VLAN_SUBNET=10.19.255.0/24
VLAN_GATEWAY=10.19.255.1
VLAN_IP_RANGE=10.19.255.0/26
# Squid's VLAN leg: the stack's only egress (edge router rules key on it)
PROXY_IP=10.19.255.101
# as-ingress: dashboard :80, Open WebUI :8080, LiteLLM :4000 (/ui), Hermes dashboard :9119
INGRESS_IP=10.19.255.99

# --- internal networks (no route out) ---
# as-net-blind: agents, LiteLLM, Open WebUI, as-dns; Docker assigns addresses from the range
BLIND_SUBNET=172.31.250.0/24
BLIND_IP_RANGE=172.31.250.128/25
# as-dns, the one fixed address inside (resolv.conf needs an IP): outside BLIND_IP_RANGE
DNS_IP=172.31.250.53
# LiteLLM <-> Squid only (LLM provider APIs)
LLM_EGRESS_SUBNET=172.31.251.0/24
# as-headroom <-> Squid only (Hugging Face model downloads, squid/conf/headroom_domains.txt)
HEADROOM_EGRESS_SUBNET=172.31.252.0/24
# LiteLLM <-> PostgreSQL
DB_SUBNET=172.31.254.0/24

# resolvers Squid uses for internet names, space-separated; reached over the VLAN leg
# (e.g. the router's DNS), not the host's 127.0.0.53
SQUID_DNS_UPSTREAM=10.19.255.1

# --- access ---
# where the Hermes dashboard (as-ingress :9119) may be opened from, space-separated
HERMES_DASHBOARD_ALLOW_FROM=10.0.0.0/24
# where the as-ingress dashboard (:80, links to all published GUIs) may be opened from, space-separated
INGRESS_DASHBOARD_ALLOW_FROM=10.0.0.0/24
# additional networks allowed to use the proxy through its VLAN leg, space-separated.
# Empty: only the stack. Set it only for a LAN that really uses the proxy (e.g.
# 192.168.100.0/24), and allow it on the router too (docs/NETWORK.md, flow matrix).
SQUID_LOCALNET_EXTRA=
# additional NO_PROXY entries, comma-separated (rarely needed: nothing outside
# as-net-blind is reachable without Squid)
NO_PROXY_EXTRA=

# --- optional ---
# Claude bridge directories (default below). Never the agent's claude-main/data/:
# the agent could read the bridge's secrets and change its code (docs/CLAUDE_BRIDGE.md)
#CLAUDE_BRIDGE_WORKSPACE=./claude-bridge/workspace
#CLAUDE_BRIDGE_HOME=./claude-bridge/home

# --- as-claude-qwen (profile qwen; check-env.sh requires both then) ---
# the LiteLLM model_name Claude Code uses (litellm/models/*.yaml)
CLAUDE_QWEN_MODEL=
# its context window in tokens (vLLM max_model_len), e.g. 131072; Claude Code does not know the model
CLAUDE_QWEN_CONTEXT_TOKENS=

# version pinning (floating tags by default; CoreDNS and LiteLLM pinned)
#CLAUDE_CODE_VERSION=latest
#HERMES_IMAGE=nousresearch/hermes-agent:stable
# LiteLLM: v1.110.x is the last release litellm/run.sh supports (root, docker/prod_entrypoint.sh);
# v1.111.0 (main-stable since 2026-11-25) runs as uid 65532 with a new entrypoint
#LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.110.4
#OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
#POSTGRES_IMAGE=postgres:16-alpine
#NETSHOOT_IMAGE=nicolaka/netshoot:latest
#COREDNS_IMAGE=coredns/coredns:1.12.4
#CADDY_IMAGE=caddy:2.8.4-alpine
#HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:0.42.0
# message bus: the eclipse/zenoh tag and the agents' client (eclipse-zenoh) version
#ZENOH_VERSION=1.10.2
# opencode (@opencode/cli on npm), baked into agents-sandbox/opencode
#OPENCODE_VERSION=2.3.2
# owner of zenoh/logs, as-zenoh runs as it
#ZENOH_UID=1000
#ZENOH_GID=1000
# owner of dns/logs, ingress/logs, llm-gw/logs and headroom/data; as-dns, as-ingress,
# as-llm-gw and as-headroom run as it
#LOGS_UID=1000
#LOGS_GID=1000

# limits per Claude agent container (as-claude-main, as-claude-qwen): memory (no swap
# beyond it), processes, CPUs
#AGENT_MEM_LIMIT=4g
#AGENT_PIDS_LIMIT=2048
#AGENT_CPUS=2
# limits of as-hermes (shm 1g and a browser included)
#HERMES_MEM_LIMIT=6g
#HERMES_PIDS_LIMIT=4096
#HERMES_CPUS=2

# full-trust (privileged) mode for Hermes, see compose.hermes-privileged.yaml
#COMPOSE_FILE=docker-compose.yaml:compose.hermes-privileged.yaml
