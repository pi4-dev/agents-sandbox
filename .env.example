# The only place with addressing. Services and agents use *.as.internal names:
# Docker network aliases (docker-compose.yaml), served to agents by as-dns.

# --- VLAN (macvlan): only the outer legs of as-squid and as-ingress ---
VLAN_PARENT=vlan100
VLAN_SUBNET=192.19.255.0/24
VLAN_GATEWAY=192.19.255.1
VLAN_IP_RANGE=192.19.255.0/26
# Squid's VLAN leg: the stack's only egress (edge router rules key on it)
PROXY_IP=192.19.255.101
# as-ingress: dashboard :80, Open WebUI :8080, LiteLLM :4000 (/ui), Hermes dashboard :9119
INGRESS_IP=192.19.255.99

# --- internal networks (no route out) ---
# as-net-blind: agents, LiteLLM, Open WebUI, as-dns; Docker assigns addresses from the range
BLIND_SUBNET=172.31.250.0/24
BLIND_IP_RANGE=172.31.250.128/25
# as-dns, the one fixed address inside (resolv.conf needs an IP): outside BLIND_IP_RANGE
DNS_IP=172.31.250.53
# LiteLLM <-> Squid only (LLM provider APIs)
LLM_EGRESS_SUBNET=172.31.251.0/24
# LiteLLM <-> PostgreSQL
DB_SUBNET=172.31.254.0/24

# resolvers Squid uses for internet names, space-separated; reached over the VLAN leg
# (e.g. the router's DNS), not the host's 127.0.0.53
SQUID_DNS_UPSTREAM=192.19.255.1

# --- access ---
# where the Hermes dashboard (as-ingress :9119) may be opened from, space-separated
HERMES_DASHBOARD_ALLOW_FROM=10.0.0.0/24
# where the as-ingress dashboard (:80, links to all published GUIs) may be opened from, space-separated
INGRESS_DASHBOARD_ALLOW_FROM=10.0.0.0/24
# additional networks allowed to use the proxy through its VLAN leg, space-separated
SQUID_LOCALNET_EXTRA=192.168.100.0/24
# additional NO_PROXY entries, comma-separated (rarely needed: nothing outside
# as-net-blind is reachable without Squid)
NO_PROXY_EXTRA=

# --- optional ---
# Claude bridge directories (default below). Never the agent's claude-main/data/:
# the agent could read the bridge's secrets and change its code (docs/CLAUDE_BRIDGE.md)
#CLAUDE_BRIDGE_WORKSPACE=./claude-bridge/workspace
#CLAUDE_BRIDGE_HOME=./claude-bridge/home

# version pinning (floating tags by default, CoreDNS pinned)
#CLAUDE_CODE_VERSION=latest
#HERMES_IMAGE=nousresearch/hermes-agent:stable
#LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
#OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
#POSTGRES_IMAGE=postgres:16-alpine
#NETSHOOT_IMAGE=nicolaka/netshoot:latest
#COREDNS_IMAGE=coredns/coredns:1.12.4
#CADDY_IMAGE=caddy:2.8.4-alpine

# full-trust (privileged) mode for Hermes, see compose.hermes-privileged.yaml
#COMPOSE_FILE=docker-compose.yaml:compose.hermes-privileged.yaml
