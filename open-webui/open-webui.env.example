OPENAI_API_BASE_URL=http://litellm.as.internal:4000/v1
# LiteLLM virtual key for Open WebUI (not LITELLM_MASTER_KEY). Generated by gen-secrets.sh,
# registered in LiteLLM by as-litellm-keys (alias "open-webui").
OPENAI_API_KEY=CHANGE_ME_LITELLM_KEY_OPEN_WEBUI
# openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGE_ME_WEBUI_SECRET_KEY
# The first account registered in the UI becomes admin (the UI is reachable from the LAN).
# After creating it, disable sign-up in Admin Panel > Settings; Open WebUI stores
# that option in its database, so changing ENABLE_SIGNUP in env later may have no effect.
WEBUI_AUTH=true
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
ENABLE_OLLAMA_API=false
RAG_EMBEDDING_ENGINE=
ENABLE_VERSION_UPDATE_CHECK=false
