# Proxy variables for applications (configuration, not a security control:
# as-net-blind has no route out). as-dns resolves the names.
http_proxy=http://proxy.as.internal:3128
https_proxy=http://proxy.as.internal:3128
HTTP_PROXY=http://proxy.as.internal:3128
HTTPS_PROXY=http://proxy.as.internal:3128
# .as.internal = all stack services (as-net-blind); the subnet is for clients connecting
# by IP (not every client understands CIDR; use NO_PROXY_EXTRA then). LAN hosts
# (*.lan.internal) are not listed: they are reached through Squid.
no_proxy=localhost,127.0.0.1,.as.internal,${BLIND_SUBNET},${NO_PROXY_EXTRA:-}
NO_PROXY=localhost,127.0.0.1,.as.internal,${BLIND_SUBNET},${NO_PROXY_EXTRA:-}
